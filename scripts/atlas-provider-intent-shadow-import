#!/usr/bin/env python3
"""Explicit local-admin entry point for legacy Provider Intent shadow import."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ATLAS_CORE = Path(__file__).resolve().parents[1] / "services" / "atlas-core"
sys.path.insert(0, str(ATLAS_CORE))

from app.provider_intents.legacy_import import import_legacy_policy
from app.provider_intents.store import ProviderIntentStoreError


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Import legacy Proxmox expectations as non-authoritative evidence."
    )
    parser.add_argument("--source-policy", type=Path, required=True)
    parser.add_argument("--store", type=Path, required=True)
    return parser


def main() -> int:
    args = _parser().parse_args()
    try:
        result = import_legacy_policy(args.source_policy, args.store)
    except (OSError, TypeError, ValueError, ProviderIntentStoreError) as error:
        print(f"provider intent shadow import failed: {error}", file=sys.stderr)
        return 1
    print(
        json.dumps(
            {
                "import_id": result.import_id,
                "record_count": result.record_count,
                "source_policy_digest": result.source_policy_digest,
                "status": result.outcome,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
