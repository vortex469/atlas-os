#!/usr/bin/env bash

set -euo pipefail

verify_staged_repository_head() {
    local staged_repository=$1
    local expected_head=$2
    local staged_head

    [[ -d "$staged_repository/.git" ]] || {
        echo "Staged repository does not contain a self-contained .git directory: $staged_repository" >&2
        return 1
    }
    [[ "$(git -C "$staged_repository" rev-parse --is-inside-work-tree)" = "true" ]] || {
        echo "Staged repository is not a Git worktree: $staged_repository" >&2
        return 1
    }
    staged_head="$(git -C "$staged_repository" rev-parse --verify 'HEAD^{commit}')"
    [[ "$staged_head" = "$expected_head" ]] || {
        echo "Staged repository HEAD mismatch: expected $expected_head, found $staged_head" >&2
        return 1
    }
}

stage_candidate_repository() {
    local source_repository=$1
    local staged_repository=$2
    local candidate_head

    candidate_head="$(git -C "$source_repository" rev-parse --verify 'HEAD^{commit}')"
    if ! git -C "$source_repository" diff --quiet --ignore-submodules -- || \
        ! git -C "$source_repository" diff --cached --quiet --ignore-submodules --; then
        echo "Candidate repository has tracked uncommitted changes; refusing to stage committed HEAD." >&2
        return 1
    fi

    # --no-local prevents alternates/shared object stores and --no-hardlinks makes
    # the staged object database independent of the source repository.
    git clone --quiet --no-local --no-hardlinks --no-checkout \
        "$source_repository" "$staged_repository" || return
    git -C "$staged_repository" checkout --quiet --detach "$candidate_head"
    verify_staged_repository_head "$staged_repository" "$candidate_head"
    printf '%s\n' "$candidate_head"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ATLAS_ROOT="$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)"
COMPOSE_FILE="$ATLAS_ROOT/compose.production.yaml"
HTTPS_COMPOSE_FILE="$ATLAS_ROOT/compose.https.yaml"
POLICY_TEMPLATE_FILE="$ATLAS_ROOT/config/policies.yaml"
ATLAS_CONFIG_FILE="$ATLAS_ROOT/config/atlas.yaml"
INVENTORY_FILE="$ATLAS_ROOT/inventory/services.yaml"

case "${ATLAS_CONTAINER_GATE_MODE:-production}" in
    production)
        gate_runtime=runsc
        gate_worker_runtime_yaml=""
        gate_agent_override_yaml=""
        ;;
    github-integration)
        gate_runtime=runc
        gate_worker_runtime_yaml="    runtime: runc"
        gate_agent_override_yaml=$'  atlas-agent:\n    entrypoint: []'
        echo "NOTICE: GitHub container integration mode uses runc; gVisor/runsc is not validated by this run."
        echo "NOTICE: GitHub integration validates Agent auth staging but not authenticated Codex login."
        ;;
    *)
        echo "Unsupported ATLAS_CONTAINER_GATE_MODE: ${ATLAS_CONTAINER_GATE_MODE}" >&2
        exit 2
        ;;
esac

GATE_DIRECTORY="$(mktemp -d /tmp/atlas-container-gate.XXXXXX)"
GATE_ENV_FILE="$GATE_DIRECTORY/atlas.env"
GATE_CERT_FILE="$GATE_DIRECTORY/tls.crt"
GATE_KEY_FILE="$GATE_DIRECTORY/tls.key"
GATE_HTPASSWD_FILE="$GATE_DIRECTORY/htpasswd"
GATE_CODEX_AUTH_FILE="$GATE_DIRECTORY/codex-auth.json"
GATE_COMPOSE_FILE="$GATE_DIRECTORY/compose.gate.yaml"
GATE_PROXY_CONFIG_FILE="$GATE_DIRECTORY/atlas-execution-worker-squid.conf"
GATE_STAGED_REPOSITORY="$GATE_DIRECTORY/repository"
GATE_PROJECT="atlas-release-gate-$$"
gate_auth_fixture_requires_sudo_cleanup=false

cleanup() {
    cleanup_status=$?
    if [[ "$cleanup_status" -ne 0 && -f "$GATE_COMPOSE_FILE" ]]; then
        docker compose \
            --project-name "$GATE_PROJECT" \
            --file "$COMPOSE_FILE" \
            --file "$HTTPS_COMPOSE_FILE" \
            --file "$GATE_COMPOSE_FILE" \
            logs \
            atlas-agent-auth-stager \
            atlas-execution-auth-stager \
            atlas-core-agent-auth-stager \
            atlas-agent \
            atlas-execution-worker \
            atlas-execution-worker-relay \
            >&2 || true
    fi
    if [[ -f "$GATE_COMPOSE_FILE" ]]; then
        docker compose \
            --project-name "$GATE_PROJECT" \
            --file "$COMPOSE_FILE" \
            --file "$HTTPS_COMPOSE_FILE" \
            --file "$GATE_COMPOSE_FILE" \
            down \
            --volumes \
            --rmi local \
            --remove-orphans \
            >/dev/null 2>&1 || true
    fi
    if [[ "$gate_auth_fixture_requires_sudo_cleanup" = "true" ]]; then
        sudo rm -f "$GATE_CODEX_AUTH_FILE"
    fi
    rm -f \
        "$GATE_ENV_FILE" \
        "$GATE_CERT_FILE" \
        "$GATE_KEY_FILE" \
        "$GATE_HTPASSWD_FILE" \
        "$GATE_CODEX_AUTH_FILE" \
        "$GATE_COMPOSE_FILE" \
        "$GATE_PROXY_CONFIG_FILE"
    rm -rf -- "$GATE_STAGED_REPOSITORY"
    rmdir "$GATE_DIRECTORY" 2>/dev/null || true
    return "$cleanup_status"
}

trap cleanup EXIT

candidate_head="$(stage_candidate_repository "$ATLAS_ROOT" "$GATE_STAGED_REPOSITORY")"
export ATLAS_REPOSITORY_HOST_PATH="$GATE_STAGED_REPOSITORY"

for executable in docker curl git openssl python3; do
    if ! command -v "$executable" >/dev/null 2>&1; then
        echo "Required executable not found: $executable" >&2
        exit 127
    fi
done

if [[ ! -S /var/run/docker.sock ]]; then
    echo "Docker socket not found: /var/run/docker.sock" >&2
    exit 1
fi

docker info --format '{{json .Runtimes}}' \
    | python3 -c '
import json
import sys

required = sys.argv[1]
runtimes = json.load(sys.stdin)
if required not in runtimes:
    raise SystemExit(f"Required container runtime is unavailable: {required}")
' "$gate_runtime"

if [[ -z "${ATLAS_CODEX_AUTH_HOST_PATH+x}" ]]; then
    printf '{}\n' >"$GATE_CODEX_AUTH_FILE"
    chmod 0400 "$GATE_CODEX_AUTH_FILE"
    if [[ "${ATLAS_CONTAINER_GATE_MODE:-production}" = "github-integration" && "$(id -u)" != "0" ]]; then
        command -v sudo >/dev/null 2>&1 || {
            echo "GitHub integration mode requires sudo to create the root-readable auth fixture" >&2
            exit 127
        }
        sudo chown 0:0 "$GATE_CODEX_AUTH_FILE"
        gate_auth_fixture_requires_sudo_cleanup=true
    fi
    export ATLAS_CODEX_AUTH_HOST_PATH="$GATE_CODEX_AUTH_FILE"
fi

printf '%s\n' \
    'PROXMOX_USER=release-gate' \
    'PROXMOX_TOKEN_NAME=release-gate' \
    'PROXMOX_TOKEN_VALUE=release-gate' \
    'HASS_TOKEN=release-gate' \
    >"$GATE_ENV_FILE"

openssl req \
    -x509 \
    -newkey rsa:2048 \
    -nodes \
    -days 1 \
    -subj '/CN=127.0.0.1' \
    -addext 'subjectAltName=IP:127.0.0.1' \
    -keyout "$GATE_KEY_FILE" \
    -out "$GATE_CERT_FILE" \
    >/dev/null 2>&1
printf 'atlas:%s\n' \
    "$(openssl passwd -apr1 'release-gate')" \
    >"$GATE_HTPASSWD_FILE"
gate_uid="$(id -u)"
if [[ "$gate_uid" = "0" ]]; then
    export ATLAS_EDGE_UID=101
    chown "$ATLAS_EDGE_UID:$ATLAS_EDGE_UID" \
        "$GATE_CERT_FILE" \
        "$GATE_KEY_FILE" \
        "$GATE_HTPASSWD_FILE"
else
    export ATLAS_EDGE_UID="$gate_uid"
fi
chmod 600 "$GATE_KEY_FILE" "$GATE_HTPASSWD_FILE"
chmod 644 "$GATE_CERT_FILE"

network_inventory="$(docker network inspect $(docker network ls --quiet))"
gate_worker_subnet="$(
    printf '%s' "$network_inventory" | python3 -c '
import ipaddress
import json
import sys

networks = json.load(sys.stdin)
used = []
for network in networks:
    for config in network.get("IPAM", {}).get("Config") or []:
        subnet = config.get("Subnet")
        if subnet:
            used.append(ipaddress.ip_network(subnet))

for third_octet in range(256):
    candidate = ipaddress.ip_network(f"10.253.{third_octet}.0/24")
    if not any(candidate.version == current.version and candidate.overlaps(current) for current in used):
        print(candidate)
        break
else:
    raise SystemExit("No non-overlapping release-gate worker subnet is available.")
'
)"
gate_worker_prefix="${gate_worker_subnet%0/24}"
gate_proxy_address="${gate_worker_prefix}2"
gate_relay_address="${gate_worker_prefix}3"
gate_worker_address="${gate_worker_prefix}10"

sed \
    "s#^acl worker_net src .*#acl worker_net src $gate_worker_subnet#" \
    "$ATLAS_ROOT/deploy/proxy/atlas-execution-worker-squid.conf" \
    >"$GATE_PROXY_CONFIG_FILE"

printf '%s\n' \
    'services:' \
    '  atlas-execution-worker:' \
    "$gate_worker_runtime_yaml" \
    '    networks:' \
    '      atlas-execution-worker-net:' \
    "        ipv4_address: $gate_worker_address" \
    '    environment:' \
    "      HTTPS_PROXY: http://$gate_proxy_address:3128" \
    "      HTTP_PROXY: http://$gate_proxy_address:3128" \
    "      ALL_PROXY: http://$gate_proxy_address:3128" \
    "      ATLAS_EXECUTION_WORKER_ALLOWED_CLIENT_HOST: $gate_relay_address" \
    '  atlas-egress-proxy:' \
    '    networks:' \
    '      atlas-execution-worker-net:' \
    "        ipv4_address: $gate_proxy_address" \
    '  atlas-execution-worker-relay:' \
    '    networks:' \
    '      atlas-execution-worker-net:' \
    "        ipv4_address: $gate_relay_address" \
    '    volumes:' \
    "      - $GATE_PROXY_CONFIG_FILE:/etc/squid/squid.conf:ro" \
    "$gate_agent_override_yaml" \
    'networks:' \
    '  atlas-execution-worker-net:' \
    '    ipam:' \
    '      config:' \
    "        - subnet: $gate_worker_subnet" \
    >"$GATE_COMPOSE_FILE"

export ATLAS_ENV_FILE="$GATE_ENV_FILE"
export ATLAS_HTTP_BIND=127.0.0.1
export ATLAS_HTTP_PORT=0
export ATLAS_HTTPS_BIND=127.0.0.1
export ATLAS_HTTPS_PORT=0
verify_staged_repository_head "$ATLAS_REPOSITORY_HOST_PATH" "$candidate_head"
export ATLAS_TLS_CERT_FILE="$GATE_CERT_FILE"
export ATLAS_TLS_KEY_FILE="$GATE_KEY_FILE"
export ATLAS_HTPASSWD_FILE="$GATE_HTPASSWD_FILE"
export DOCKER_GID
DOCKER_GID="$(stat -c '%g' /var/run/docker.sock)"
policy_template_checksum_before="$(sha256sum "$POLICY_TEMPLATE_FILE" | awk '{print $1}')"
atlas_config_checksum_before="$(sha256sum "$ATLAS_CONFIG_FILE" | awk '{print $1}')"
inventory_checksum_before="$(sha256sum "$INVENTORY_FILE" | awk '{print $1}')"

compose=(
    docker compose
    --project-name "$GATE_PROJECT"
    --file "$COMPOSE_FILE"
    --file "$HTTPS_COMPOSE_FILE"
    --file "$GATE_COMPOSE_FILE"
)

echo "Validating HTTP and HTTPS Compose configuration"
"$ATLAS_ROOT/scripts/operational-capability-parity"
docker compose \
    --project-name "$GATE_PROJECT" \
    --file "$COMPOSE_FILE" \
    config \
    --no-env-resolution \
    --quiet
"${compose[@]}" config --no-env-resolution --quiet

echo "Building production images"
"${compose[@]}" build

echo "Starting isolated production stack"
"${compose[@]}" up --detach --wait --wait-timeout 90

if [[ "${ATLAS_CONTAINER_GATE_MODE:-production}" = "production" ]]; then
    echo "Checking production runsc sandbox and transport boundary"
else
    echo "Checking container integration hardening with runc (not a gVisor proof)"
fi
ATLAS_EXECUTION_GATE_COMPOSE_OVERRIDE="$GATE_COMPOSE_FILE" \
    ATLAS_EXECUTION_GATE_COMPOSE_SECONDARY="$HTTPS_COMPOSE_FILE" \
    ATLAS_EXECUTION_GATE_PROJECT="$GATE_PROJECT" \
    "$ATLAS_ROOT/scripts/atlas-execution-worker-runtime-gate"

core_container="$("${compose[@]}" ps --quiet atlas-core)"
agent_container="$("${compose[@]}" ps --quiet atlas-agent)"
mission_container="$("${compose[@]}" ps --quiet mission-control)"
edge_container="$("${compose[@]}" ps --quiet atlas-edge)"

for container in "$core_container" "$agent_container" "$mission_container" "$edge_container"; do
    test -n "$container"
    test "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$container")" = "true"
    test "$(docker inspect --format '{{json .HostConfig.CapDrop}}' "$container")" = '["ALL"]'
    docker inspect \
        --format '{{json .HostConfig.SecurityOpt}}' \
        "$container" \
        | grep -q 'no-new-privileges:true'

    container_user="$(docker inspect --format '{{.Config.User}}' "$container")"
    test -n "$container_user"
    test "$container_user" != "0"
    test "$container_user" != "root"
done

echo "Checking Atlas Agent container hardening and mounts"
test "$(docker inspect --format '{{json .HostConfig.PortBindings}}' "$agent_container")" = '{}'
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/workspace/repository"}}{{.Type}} {{.Source}}{{end}}{{end}}' \
    "$agent_container")" = "bind $ATLAS_REPOSITORY_HOST_PATH"
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/opt/atlas/agent-state"}}{{.Type}}{{end}}{{end}}' \
    "$agent_container")" = "volume"
! docker inspect \
    --format '{{range .Mounts}}{{println .Destination}}{{end}}' \
    "$agent_container" \
    | grep -qx '/var/run/docker.sock'
docker exec "$agent_container" python -c "from pathlib import Path; path = Path('/opt/atlas/agent-state/.release-gate-write-test'); path.write_text('ok'); path.unlink()"
docker exec "$agent_container" python -c "from pathlib import Path; metadata = Path('/run/secrets/codex-auth.json').stat(); assert metadata.st_uid == 10001; assert metadata.st_gid == 10001; assert metadata.st_mode & 0o777 == 0o600"
if [[ "$gate_auth_fixture_requires_sudo_cleanup" = "true" ]]; then
    gate_auth_fixture_contents="$(sudo cat "$ATLAS_CODEX_AUTH_HOST_PATH")"
else
    gate_auth_fixture_contents="$(cat "$ATLAS_CODEX_AUTH_HOST_PATH")"
fi
test "$(docker exec "$agent_container" cat /run/secrets/codex-auth.json)" = \
    "$gate_auth_fixture_contents"

echo "Checking dedicated Agent-to-Core authentication staging"
for container in "$core_container" "$agent_container"; do
    docker exec "$container" python -c "from pathlib import Path; metadata = Path('/run/atlas-core-agent-auth/token').stat(); assert metadata.st_uid == 10001; assert metadata.st_gid == 10001; assert metadata.st_mode & 0o777 == 0o400"
done
core_agent_token_digest="$(docker exec "$core_container" sha256sum /run/atlas-core-agent-auth/token | awk '{print $1}')"
test "$core_agent_token_digest" = \
    "$(docker exec "$agent_container" sha256sum /run/atlas-core-agent-auth/token | awk '{print $1}')"

echo "Checking Atlas Core Docker socket access and hardening"
test "$(docker exec "$core_container" id -u)" = "10001"
docker exec "$core_container" sh -c "id -G | tr ' ' '\n' | grep -qx '$DOCKER_GID'"
docker exec "$core_container" test -S /var/run/docker.sock
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/var/run/docker.sock"}}{{.RW}}{{end}}{{end}}' \
    "$core_container")" = "false"
docker exec "$core_container" python - <<'PY'
from app.services.atlas_contexts import LegacyAtlasContextResolver
from app.clients.docker_client import create_docker_client, docker_connection_diagnostics

context = LegacyAtlasContextResolver().resolve_context("docker")
diagnostics = docker_connection_diagnostics(context)
assert context.connection is not None
assert context.connection.mode == "unix"
assert context.connection.path == "/var/run/docker.sock"
assert diagnostics["privileged_local_runtime"] is True
assert diagnostics["editable"] is False
assert diagnostics["socket_exists"] is True
client = create_docker_client(context)
assert client.ping() is True
PY

https_published_address="$("${compose[@]}" port atlas-edge 8443)"
https_published_port="${https_published_address##*:}"
https_base_url="https://127.0.0.1:$https_published_port"
base_url="$https_base_url"
curl=(curl --cacert "$GATE_CERT_FILE" --user 'atlas:release-gate')

docker inspect --format '{{json .HostConfig.PortBindings}}' "$mission_container" \
    | python3 -c 'import json,sys; bindings=json.load(sys.stdin) or {}; assert not any(bindings.values()), bindings'
docker exec "$edge_container" wget --quiet --output-document=- \
    http://mission-control:8080/ \
    | grep -q '<title>mission-control</title>'

echo "Checking Atlas Core runtime policy storage"
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/opt/atlas/config/policies.yaml"}}{{.RW}}{{end}}{{end}}' \
    "$core_container")" = "false"
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/opt/atlas/data"}}{{.RW}}{{end}}{{end}}' \
    "$core_container")" = "true"
test "$(docker inspect \
    --format '{{range .Mounts}}{{if eq .Destination "/opt/atlas/data"}}{{.Type}}{{end}}{{end}}' \
    "$core_container")" = "volume"
docker exec "$core_container" python -c "import os; assert os.environ['ATLAS_POLICY_FILE'] == '/opt/atlas/data/config/policies.yaml'; assert os.environ['ATLAS_POLICY_TEMPLATE_FILE'] == '/opt/atlas/config/policies.yaml'"
docker exec "$core_container" python -c "from pathlib import Path; import os; assert not os.access('/opt/atlas/config/policies.yaml', os.W_OK); assert os.access('/opt/atlas/data', os.W_OK); Path('/opt/atlas/data/config').mkdir(parents=True, exist_ok=True); probe = Path('/opt/atlas/data/config/.release-gate-write-test'); probe.write_text('ok'); probe.unlink()"
"${curl[@]}" --fail --silent --show-error "$base_url/api/v1/policies/status" \
    | grep -q '"status":"healthy"'
docker exec "$core_container" test -f /opt/atlas/data/config/policies.yaml
docker exec "$core_container" cmp -s \
    /opt/atlas/config/policies.yaml \
    /opt/atlas/data/config/policies.yaml
"${curl[@]}" --fail --silent --show-error \
    --request PUT \
    --header 'Content-Type: application/json' \
    --data '{"expectation":"stopped","confirmed":true}' \
    "$base_url/api/v1/providers/proxmox/resources/110/expectation" \
    | grep -q '"resource_id":"110"'
"${curl[@]}" --fail --silent --show-error "$base_url/api/v1/policies" \
    | grep -q '"110":{"expected":"stopped"}'
docker exec -i "$core_container" python - <<'PY'
import asyncio

from app.models.provider_management import ManagedResourceIdentityAssurance
from app.provider_intents.authority import get_monitoring_intent_authority
from app.providers.proxmox import ProxmoxProvider
from app.providers.management import provider_resource_management_registry
from app.services.provider_management import project_managed_resource
import app.providers.proxmox as proxmox_module

def fake_guests():
    return {
        "node": "release-gate",
        "running": 0,
        "stopped": 2,
        "guests": [
            {
                "vmid": 109,
                "name": "release-gate-lxc",
                "type": "lxc",
                "status": "stopped",
            },
            {
                "vmid": 110,
                "name": "release-gate-qemu",
                "type": "qemu",
                "status": "stopped",
                "vmgenid": "11111111-1111-1111-1111-111111111111",
            },
        ],
    }

proxmox_module.get_proxmox_guests = fake_guests
provider = ProxmoxProvider({"name": "Proxmox"})
observed = asyncio.run(provider.list_resources())
assert {item.resource_id for item in observed.resources} == {"109", "110"}
resources = get_monitoring_intent_authority().resolve_collection(observed).resources
by_id = {item.resource_id: item for item in resources}

qemu = by_id["110"]
assert qemu.identity is not None
assert qemu.expectation.value == "stopped"
assert qemu.expectation.label == "Expected Stopped"
qemu_projection = project_managed_resource(qemu)
assert qemu_projection.identity_assurance is ManagedResourceIdentityAssurance.AUTHORITATIVE
assert qemu_projection.management_fingerprint is not None

lxc = by_id["109"]
assert lxc.identity is None
lxc_support = provider_resource_management_registry.get("proxmox", "lxc")
assert lxc_support.resource_readable is True
assert lxc_support.authoritative_identity_supported is False
assert lxc_support.provider_intent_capability_supported is False
lxc_projection = project_managed_resource(lxc)
assert lxc_projection.identity_assurance is ManagedResourceIdentityAssurance.UNAVAILABLE
assert lxc_projection.management_fingerprint is None
assert lxc_projection.mutation_available is False
assert lxc_projection.operationally_requestable is False
PY
test "$(sha256sum "$POLICY_TEMPLATE_FILE" | awk '{print $1}')" = \
    "$policy_template_checksum_before"

echo "Checking Atlas Core provider connection runtime storage"
docker exec -i "$core_container" python - <<'PY'
import os

assert os.environ["ATLAS_PROVIDER_CONNECTION_FILE"] == "/opt/atlas/data/config/provider-connections.yaml"
assert os.environ["ATLAS_PROVIDER_CONNECTION_TEMPLATE_FILE"] == "/opt/atlas/config/provider-connections.yaml"
assert os.environ["ATLAS_PROVIDER_SECRET_FILE"] == "/opt/atlas/data/secrets/provider-connections.yaml"
PY
docker exec -i "$core_container" python - <<'PY'
from pathlib import Path

from app.config.provider_connections import (
    ensure_provider_connection_file,
    load_provider_connections,
)
from app.config.provider_secrets import ensure_provider_secret_file, load_provider_secrets

connection_file = ensure_provider_connection_file()
secret_file = ensure_provider_secret_file()
assert connection_file == Path("/opt/atlas/data/config/provider-connections.yaml")
assert secret_file == Path("/opt/atlas/data/secrets/provider-connections.yaml")
assert connection_file.exists()
assert secret_file.exists()
assert connection_file.parent.is_dir()
assert secret_file.parent.is_dir()
assert load_provider_connections(connection_file).version == 1
assert load_provider_secrets(secret_file).version == 1
secret_stat = secret_file.stat()
assert secret_stat.st_uid == 10001
assert secret_stat.st_gid == 10001
assert secret_stat.st_mode & 0o777 == 0o600
probe = secret_file.parent / ".release-gate-write-test"
probe.write_text("ok", encoding="utf-8")
probe.unlink()
PY
! docker exec "$agent_container" test -e /opt/atlas/data/secrets/provider-connections.yaml
"${curl[@]}" --fail --silent --show-error "$base_url/api/v1/providers/proxmox/connection" \
    | python3 -c 'import json,sys; data=json.load(sys.stdin); fields={field["key"]: field for field in data["fields"]}; assert data["provider_id"] == "proxmox"; assert fields["host"]["current_value"]; assert fields["user"]["secret"] is True; assert fields["user"]["current_value"] is None; assert fields["token_value"]["current_value"] is None'
"${curl[@]}" --fail --silent --show-error "$base_url/api/v1/providers/docker/connection" \
    | python3 -c 'import json,sys; data=json.load(sys.stdin); fields={field["key"]: field for field in data["fields"]}; assert data["provider_id"] == "docker"; assert data["editable"] is False; assert data["metadata"]["update_supported"] is False; assert data["metadata"]["privileged_local_runtime"] is True; assert fields["path"]["editable"] is False'
docker exec -i "$core_container" python - <<'PY'
import asyncio

from app.models.connections import UpdateProviderConnectionRequest
from app.providers.loader import load_provider_registry
from app.services.provider_connections import ProviderConnectionService
import app.providers.proxmox as proxmox_module


def fake_guests():
    return {
        "node": "release-gate",
        "running": 0,
        "stopped": 1,
        "guests": [
            {
                "vmid": 109,
                "name": "release-gate-guest",
                "type": "lxc",
                "status": "stopped",
            },
        ],
    }


load_provider_registry()
proxmox_module.get_proxmox_guests = fake_guests
service = ProviderConnectionService()
schema = service.connection_schema("proxmox")
host = next(field.current_value for field in schema.fields if field.key == "host")
assert host
result = asyncio.run(
    service.update_connection(
        "proxmox",
        UpdateProviderConnectionRequest(confirmed=True, values={"host": host}),
        require_test=False,
    )
)
fields = {field.key: field for field in result.connection_schema.fields}
assert fields["host"].current_value == host
assert fields["host"].source == "runtime"
schema = service.connection_schema("proxmox")
fields = {field.key: field for field in schema.fields}
assert fields["host"].source == "runtime"
resources = asyncio.run(service._registry.get("proxmox").list_resources()).resources
assert resources
PY
