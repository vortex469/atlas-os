#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_IMAGE="python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de"
GATE_DIRECTORY="$(mktemp -d /tmp/atlas-recovery-gate.XXXXXX)"
GATE_PREFIX="atlas-recovery-gate-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
PRODUCTION_VOLUME="atlas_atlas-data"
created_volumes=()

if [[ "$GATE_PREFIX" = "$PRODUCTION_VOLUME" ]]; then
    echo "Recovery gate refuses the production Atlas data volume" >&2
    exit 1
fi

create_gate_volume() {
    local volume="$1"
    if [[ "$volume" = "$PRODUCTION_VOLUME" ]]; then
        echo "Recovery gate refuses the production Atlas data volume" >&2
        exit 1
    fi
    if docker volume inspect "$volume" >/dev/null 2>&1; then
        echo "Recovery gate refuses to reuse existing volume: $volume" >&2
        exit 1
    fi
    docker volume create "$volume" >/dev/null
    created_volumes+=("$volume")
}

cleanup() {
    for volume in "${created_volumes[@]}"; do
        docker volume rm "$volume" >/dev/null 2>&1 || true
    done
    rm -rf -- "$GATE_DIRECTORY"
}
trap cleanup EXIT

for audit in false true; do
    branch="without-audit"
    if [[ "$audit" = true ]]; then
        branch="with-audit"
    fi
    volume="$GATE_PREFIX-$branch"
    backup_root="$GATE_DIRECTORY/$branch"
    mkdir -p "$backup_root"
    create_gate_volume "$volume"

    docker run \
        --rm \
        --network none \
        --read-only \
        --cap-drop ALL \
        --cap-add CHOWN \
        --security-opt no-new-privileges:true \
        --user 0:0 \
        --mount "type=volume,src=$volume,dst=/data" \
        --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_recovery_gate_fixture.py,dst=/fixture.py,readonly" \
        "$PYTHON_IMAGE" \
        python /fixture.py seed /data "$audit"

    ATLAS_DATA_VOLUME="$volume" ATLAS_OPERATOR_AUTH_ENABLED="$audit" \
        "$SCRIPT_DIRECTORY/atlas-data-backup" "$backup_root"
    backup_directory="$(
        find "$backup_root" -mindepth 1 -maxdepth 1 -type d \
            -name 'atlas-data-*' -print -quit
    )"
    test -n "$backup_directory"
    python3 "$SCRIPT_DIRECTORY/atlas-data-tool.py" verify "$backup_directory"
    test "$(stat -c '%a' "$backup_directory")" = 700
    test "$(find "$backup_directory" -type f ! -perm 0600 -print -quit)" = ""

    docker run \
        --rm \
        --network none \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges:true \
        --user 10001:10001 \
        --mount "type=volume,src=$volume,dst=/data" \
        --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_recovery_gate_fixture.py,dst=/fixture.py,readonly" \
        "$PYTHON_IMAGE" \
        python /fixture.py stale /data "$audit"

    ATLAS_DATA_VOLUME="$volume" \
        "$SCRIPT_DIRECTORY/atlas-data-restore" "$backup_directory" --confirm

    if [[ "$audit" = false ]]; then
        for failure_mode in handled crash; do
            failure_stage="$GATE_PREFIX-$failure_mode-stage"
            create_gate_volume "$failure_stage"
            docker run \
                --rm --network none --read-only --cap-drop ALL \
                --cap-add CHOWN --cap-add DAC_READ_SEARCH \
                --security-opt no-new-privileges:true --user 0:0 \
                --mount "type=bind,src=$backup_directory,dst=/source,readonly" \
                --mount "type=volume,src=$failure_stage,dst=/staging" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_restore_copy.py,dst=/copy.py,readonly" \
                "$PYTHON_IMAGE" \
                python /copy.py /source /staging/backup 10001 10001
            docker run \
                --rm --network none --read-only --cap-drop ALL \
                --security-opt no-new-privileges:true --user 10001:10001 \
                --mount "type=volume,src=$volume,dst=/target" \
                --mount "type=volume,src=$failure_stage,dst=/staging,readonly" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/atlas-data-tool.py,readonly" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_backup_models.py,dst=/atlas_data_backup_models.py,readonly" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_restore_transaction.py,dst=/atlas_data_restore_transaction.py,readonly" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_restore_failure_fixture.py,dst=/failure.py,readonly" \
                "$PYTHON_IMAGE" \
                python /failure.py "$failure_mode"
            if [[ "$failure_mode" = handled ]]; then
                test -z "$(
                    docker run --rm --mount "type=volume,src=$volume,dst=/data,readonly" \
                        "$PYTHON_IMAGE" sh -c 'test -e /data/.atlas-restore && echo present || true'
                )"
            fi
        done
        ATLAS_DATA_VOLUME="$volume" \
            "$SCRIPT_DIRECTORY/atlas-data-restore" "$backup_directory" --confirm
    fi

    docker run \
        --rm \
        --network none \
        --read-only \
        --cap-drop ALL \
        --security-opt no-new-privileges:true \
        --user 10001:10001 \
        --mount "type=volume,src=$volume,dst=/data,readonly" \
        --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_recovery_gate_fixture.py,dst=/fixture.py,readonly" \
        "$PYTHON_IMAGE" \
        python /fixture.py verify /data "$audit"
done

echo "Atlas data recovery gate passed: ${created_volumes[*]}"
