#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ATLAS_ROOT="$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)"
COMPOSE_FILE="$ATLAS_ROOT/deploy/rest-server/compose.yaml"
RESTIC_IMAGE="restic/restic@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510"
GATE_DIRECTORY="$(mktemp -d /tmp/atlas-rest-server-gate.XXXXXX)"
GATE_PROJECT="atlas-rest-server-gate-$$"

cleanup() {
    docker compose \
        --project-name "$GATE_PROJECT" \
        --file "$COMPOSE_FILE" \
        down \
        --volumes \
        --remove-orphans \
        >/dev/null 2>&1 || true
    rm -rf -- "$GATE_DIRECTORY"
}
trap cleanup EXIT

for executable in base64 docker openssl python3; do
    if ! command -v "$executable" >/dev/null 2>&1; then
        echo "Required executable not found: $executable" >&2
        exit 127
    fi
done

mkdir -p \
    "$GATE_DIRECTORY/backups" \
    "$GATE_DIRECTORY/data" \
    "$GATE_DIRECTORY/restore" \
    "$GATE_DIRECTORY/source"

python3 - "$GATE_DIRECTORY/source" <<'PY'
import sqlite3
import sys
from pathlib import Path

directory = Path(sys.argv[1])
schemas = {
    "action_history.db": """CREATE TABLE provider_action_history
        (id TEXT PRIMARY KEY, provider_id TEXT NOT NULL, provider_name TEXT NOT NULL,
        action_id TEXT NOT NULL, action_label TEXT NOT NULL, status TEXT NOT NULL,
        success INTEGER NOT NULL, message TEXT NOT NULL, confirmed INTEGER NOT NULL,
        destructive INTEGER NOT NULL, parameter_names TEXT NOT NULL, request_id TEXT,
        started_at TEXT NOT NULL, completed_at TEXT NOT NULL, duration_ms REAL NOT NULL);
        CREATE INDEX idx_provider_action_history_completed_at ON provider_action_history(completed_at DESC);
        CREATE INDEX idx_provider_action_history_provider_status ON provider_action_history(provider_id,status,completed_at DESC);""",
    "provider_intelligence.db": """CREATE TABLE intelligence_telemetry
        (id TEXT PRIMARY KEY, collected_at TEXT NOT NULL, telemetry TEXT NOT NULL);
        CREATE INDEX idx_intelligence_telemetry_collected_at ON intelligence_telemetry(collected_at DESC);""",
    "operational_dispatch.db": """CREATE TABLE operational_dispatch
        (request_id TEXT PRIMARY KEY, request_digest TEXT NOT NULL, state TEXT NOT NULL,
        request_json TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
        dispatch_started_at TEXT, dispatch_result_json TEXT, verification_result_json TEXT);
        CREATE TABLE operational_dispatch_events
        (event_id TEXT PRIMARY KEY, status TEXT NOT NULL, occurred_at TEXT NOT NULL, event_json TEXT NOT NULL);
        CREATE INDEX idx_operational_dispatch_events_time ON operational_dispatch_events(occurred_at DESC);
        CREATE TABLE operational_dispatch_transitions
        (sequence INTEGER PRIMARY KEY AUTOINCREMENT, request_id TEXT NOT NULL,
        request_digest TEXT NOT NULL, previous_state TEXT, state TEXT NOT NULL, occurred_at TEXT NOT NULL);
        CREATE INDEX idx_operational_dispatch_transitions_request ON operational_dispatch_transitions(request_id,sequence);""",
    "operator_intents.db": """CREATE TABLE operator_intents
        (record_id TEXT PRIMARY KEY, request_digest TEXT NOT NULL, record_json TEXT NOT NULL,
        created_at TEXT NOT NULL, expires_at TEXT NOT NULL, schema_version INTEGER NOT NULL);
        CREATE TABLE operator_intent_audit
        (sequence INTEGER PRIMARY KEY AUTOINCREMENT, occurred_at TEXT NOT NULL, record_id TEXT,
        candidate_id TEXT, operator_id TEXT, event TEXT NOT NULL, reason TEXT NOT NULL);""",
}
for filename, schema in schemas.items():
    connection = sqlite3.connect(directory / filename)
    connection.executescript(schema)
    connection.commit()
    connection.close()
(directory / "config").mkdir()
(directory / "secrets").mkdir()
(directory / "config/policies.yaml").write_text("proxmox:\n  guests: {}\n", encoding="utf-8")
(directory / "config/provider-connections.yaml").write_text("version: 1\nproviders: {}\n", encoding="utf-8")
secret = directory / "secrets/provider-connections.yaml"
secret.write_text("version: 1\nproviders: {}\n", encoding="utf-8")
secret.chmod(0o600)
PY
python3 "$SCRIPT_DIRECTORY/atlas-data-tool.py" backup \
    "$GATE_DIRECTORY/source" \
    "$GATE_DIRECTORY/backups/atlas-data-20000101T000000Z" \
    --operator-auth-initialized false

openssl req \
    -x509 \
    -newkey rsa:2048 \
    -nodes \
    -days 1 \
    -subj '/CN=127.0.0.1' \
    -addext 'subjectAltName=IP:127.0.0.1' \
    -keyout "$GATE_DIRECTORY/server.key" \
    -out "$GATE_DIRECTORY/server.crt" \
    >/dev/null 2>&1
password_hash="$(
    printf '%s' 'transport-gate-password' \
        | openssl dgst -sha1 -binary \
        | base64
)"
printf 'atlas:{SHA}%s\n' "$password_hash" >"$GATE_DIRECTORY/htpasswd"
printf '%s\n' \
    'RESTIC_REPOSITORY=rest:https://127.0.0.1:8000/atlas' \
    'RESTIC_REST_USERNAME=atlas' \
    'RESTIC_REST_PASSWORD=transport-gate-password' \
    'RESTIC_PASSWORD=repository-gate-password' \
    >"$GATE_DIRECTORY/restic.env"

gate_uid="$(id -u)"
gate_gid="$(id -g)"
if [[ "$gate_uid" = "0" ]]; then
    gate_uid=10001
    gate_gid=10001
    # Rootless/user-namespaced CI may not permit chown to an unmapped ID.
    # These relaxed modes apply only inside the disposable 0700 temp tree.
    chmod 777 "$GATE_DIRECTORY/data"
    chmod 644 \
        "$GATE_DIRECTORY/server.key" \
        "$GATE_DIRECTORY/htpasswd"
else
    chmod 600 \
        "$GATE_DIRECTORY/server.key" \
        "$GATE_DIRECTORY/htpasswd"
fi
chmod 600 "$GATE_DIRECTORY/restic.env"
chmod 644 "$GATE_DIRECTORY/server.crt"

export REST_SERVER_BIND=127.0.0.1
export REST_SERVER_PORT=8000
export REST_SERVER_DATA_PATH="$GATE_DIRECTORY/data"
export REST_SERVER_HTPASSWD_FILE="$GATE_DIRECTORY/htpasswd"
export REST_SERVER_TLS_CERT_FILE="$GATE_DIRECTORY/server.crt"
export REST_SERVER_TLS_KEY_FILE="$GATE_DIRECTORY/server.key"
export REST_SERVER_UID="$gate_uid"
export REST_SERVER_GID="$gate_gid"

docker compose \
    --project-name "$GATE_PROJECT" \
    --file "$COMPOSE_FILE" \
    config \
    --quiet
docker compose \
    --project-name "$GATE_PROJECT" \
    --file "$COMPOSE_FILE" \
    up \
    --detach \
    --wait \
    --wait-timeout 30

server_container="$(
    docker compose \
        --project-name "$GATE_PROJECT" \
        --file "$COMPOSE_FILE" \
        ps \
        --quiet \
        rest-server
)"
test "$(docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' "$server_container")" = "true"
test "$(docker inspect --format '{{json .HostConfig.CapDrop}}' "$server_container")" = '["ALL"]'

ATLAS_RESTIC_ENV_FILE="$GATE_DIRECTORY/restic.env" \
ATLAS_RESTIC_CA_FILE="$GATE_DIRECTORY/server.crt" \
ATLAS_RESTIC_NETWORK=host \
    "$SCRIPT_DIRECTORY/atlas-data-replicate" "$GATE_DIRECTORY/backups" init
ATLAS_RESTIC_ENV_FILE="$GATE_DIRECTORY/restic.env" \
ATLAS_RESTIC_CA_FILE="$GATE_DIRECTORY/server.crt" \
ATLAS_RESTIC_NETWORK=host \
    "$SCRIPT_DIRECTORY/atlas-data-replicate" "$GATE_DIRECTORY/backups"

docker run \
    --rm \
    --network host \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --user "$(id -u):$(id -g)" \
    --env-file "$GATE_DIRECTORY/restic.env" \
    --env RESTIC_CACERT=/certs/ca.pem \
    --mount "type=bind,src=$GATE_DIRECTORY/server.crt,dst=/certs/ca.pem,readonly" \
    --mount "type=bind,src=$GATE_DIRECTORY/restore,dst=/restore" \
    --tmpfs /tmp:size=32m,mode=1777 \
    "$RESTIC_IMAGE" \
    --no-cache \
    restore latest --target /restore

cmp \
    "$GATE_DIRECTORY/backups/atlas-data-20000101T000000Z/action_history.db" \
    "$GATE_DIRECTORY/restore/atlas-backup/action_history.db"

echo "Rest Server replication and recovery gate passed"
