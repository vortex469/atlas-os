#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ATLAS_ROOT="$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)"
PYTHON_IMAGE="python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de"
DATA_VOLUME="${ATLAS_DATA_VOLUME:-atlas_atlas-data}"
BACKUP_ROOT="${1:-$ATLAS_ROOT/backups}"
BACKUP_NAME="atlas-data-$(date -u +%Y%m%dT%H%M%SZ)"

for executable in docker realpath; do
    if ! command -v "$executable" >/dev/null 2>&1; then
        echo "Required executable not found: $executable" >&2
        exit 127
    fi
done

docker volume inspect "$DATA_VOLUME" >/dev/null
mkdir -p "$BACKUP_ROOT"
BACKUP_ROOT="$(realpath "$BACKUP_ROOT")"
INCOMPLETE_DIRECTORY="$BACKUP_ROOT/.$BACKUP_NAME.incomplete"
BACKUP_DIRECTORY="$BACKUP_ROOT/$BACKUP_NAME"

if [[ -e "$INCOMPLETE_DIRECTORY" || -e "$BACKUP_DIRECTORY" ]]; then
    echo "Backup destination already exists: $BACKUP_DIRECTORY" >&2
    exit 1
fi
mkdir -- "$INCOMPLETE_DIRECTORY"
chmod 0777 "$INCOMPLETE_DIRECTORY"

cleanup() {
    if [[ -d "$INCOMPLETE_DIRECTORY" ]]; then
        rm -rf -- "$INCOMPLETE_DIRECTORY"
    fi
}
trap cleanup EXIT

docker run \
    --rm \
    --network none \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --user 10001:10001 \
    --mount "type=volume,src=$DATA_VOLUME,dst=/source,readonly" \
    --mount "type=bind,src=$INCOMPLETE_DIRECTORY,dst=/backup" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/tool.py,readonly" \
    "$PYTHON_IMAGE" \
    python /tool.py backup \
    /source \
    /backup

docker run \
    --rm \
    --network none \
    --read-only \
    --cap-drop ALL \
    --cap-add CHOWN \
    --security-opt no-new-privileges:true \
    --user 0:0 \
    --mount "type=bind,src=$INCOMPLETE_DIRECTORY,dst=/backup" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/tool.py,readonly" \
    "$PYTHON_IMAGE" \
    python /tool.py chown /backup "$(id -u)" "$(id -g)"
chmod -R u+rwX,go+rX "$INCOMPLETE_DIRECTORY"

mv -- "$INCOMPLETE_DIRECTORY" "$BACKUP_DIRECTORY"
trap - EXIT

echo "Atlas data backup created: $BACKUP_DIRECTORY"
