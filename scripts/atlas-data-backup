#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ATLAS_ROOT="$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)"
PYTHON_IMAGE="python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de"
CORE_RECOVERY_IMAGE="${ATLAS_CORE_RECOVERY_IMAGE:-atlas-atlas-core}"
DATA_VOLUME="${ATLAS_DATA_VOLUME:-atlas_atlas-data}"
BACKUP_ROOT="${1:-$ATLAS_ROOT/backups}"
BACKUP_NAME="atlas-data-$(date -u +%Y%m%dT%H%M%SZ)"
operator_auth_initialized="${ATLAS_OPERATOR_AUTH_ENABLED:-false}"
provider_intent_activation="${ATLAS_PROVIDER_INTENT_ACTIVATION:-not_activated}"
expected_import_id="${ATLAS_PROVIDER_INTENT_EXPECTED_LEGACY_IMPORT_ID:-}"

case "$operator_auth_initialized" in
    true|false) ;;
    *)
        echo "ATLAS_OPERATOR_AUTH_ENABLED must be true or false" >&2
        exit 2
        ;;
esac
provider_intent_options=(
    --provider-intent-activation "$provider_intent_activation"
)
if [[ -n "$expected_import_id" ]]; then
    provider_intent_options+=(--expected-legacy-import-id "$expected_import_id")
fi
case "$provider_intent_activation" in
    not_activated)
        if [[ -n "$expected_import_id" ]]; then
            echo "Inactive Provider Intent cannot accept an expected import ID" >&2
            exit 2
        fi
        backup_image="$PYTHON_IMAGE"
        ;;
    activated)
        if [[ -z "$expected_import_id" ]]; then
            echo "Activated Provider Intent requires an expected import ID" >&2
            exit 2
        fi
        backup_image="$CORE_RECOVERY_IMAGE"
        ;;
    *)
        echo "ATLAS_PROVIDER_INTENT_ACTIVATION must be not_activated or activated" >&2
        exit 2
        ;;
esac

for executable in docker realpath; do
    if ! command -v "$executable" >/dev/null 2>&1; then
        echo "Required executable not found: $executable" >&2
        exit 127
    fi
done

docker volume inspect "$DATA_VOLUME" >/dev/null
mkdir -p "$BACKUP_ROOT"
BACKUP_ROOT="$(realpath "$BACKUP_ROOT")"
INCOMPLETE_BASENAME=".$BACKUP_NAME.incomplete"
INCOMPLETE_DIRECTORY="$BACKUP_ROOT/$INCOMPLETE_BASENAME"
BACKUP_DIRECTORY="$BACKUP_ROOT/$BACKUP_NAME"
BACKUP_OWNER_UID="$(id -u)"
BACKUP_OWNER_GID="$(id -g)"

if [[ -e "$INCOMPLETE_DIRECTORY" || -e "$BACKUP_DIRECTORY" ]]; then
    echo "Backup destination already exists: $BACKUP_DIRECTORY" >&2
    exit 1
fi
mkdir -- "$INCOMPLETE_DIRECTORY"
chmod 0700 "$INCOMPLETE_DIRECTORY"

validate_incomplete_directory() {
    [[ "$INCOMPLETE_BASENAME" != */* ]]
    [[ "$INCOMPLETE_BASENAME" =~ ^\.atlas-data-[0-9]{8}T[0-9]{6}Z\.incomplete$ ]]
    [[ -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" ]]
    [[ -d "$INCOMPLETE_DIRECTORY" && ! -L "$INCOMPLETE_DIRECTORY" ]]
    [[ "$(dirname -- "$INCOMPLETE_DIRECTORY")" = "$BACKUP_ROOT" ]]
    [[ "$(basename -- "$INCOMPLETE_DIRECTORY")" = "$INCOMPLETE_BASENAME" ]]
    [[ "$(realpath -e -- "$INCOMPLETE_DIRECTORY")" = "$BACKUP_ROOT/$INCOMPLETE_BASENAME" ]]
}

cleanup() {
    original_status=$?
    if [[ -d "$INCOMPLETE_DIRECTORY" ]]; then
        if ! rm -rf -- "$INCOMPLETE_DIRECTORY"; then
            if ! validate_incomplete_directory; then
                echo "Disposable incomplete backup path failed confinement validation" >&2
                return 1
            fi
            if ! docker run \
                --rm \
                --network none \
                --read-only \
                --cap-drop ALL \
                --cap-add CHOWN \
                --cap-add DAC_READ_SEARCH \
                --security-opt no-new-privileges:true \
                --user 0:0 \
                --mount "type=bind,src=$BACKUP_ROOT,dst=/backup-parent" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/tool.py,readonly" \
                --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_backup_models.py,dst=/atlas_data_backup_models.py,readonly" \
                "$PYTHON_IMAGE" \
                python /tool.py chown-child \
                /backup-parent \
                "$INCOMPLETE_BASENAME" \
                "$BACKUP_OWNER_UID" \
                "$BACKUP_OWNER_GID"; then
                echo "Unable to restore disposable backup ownership for cleanup" >&2
                return 1
            fi
            if ! rm -rf -- "$INCOMPLETE_DIRECTORY"; then
                echo "Unable to remove disposable incomplete backup" >&2
                return 1
            fi
        fi
    fi
    return "$original_status"
}
trap cleanup EXIT

docker run \
    --rm \
    --network none \
    --read-only \
    --cap-drop ALL \
    --cap-add CHOWN \
    --security-opt no-new-privileges:true \
    --user 0:0 \
    --mount "type=bind,src=$INCOMPLETE_DIRECTORY,dst=/backup" \
    "$PYTHON_IMAGE" \
    chown 10001:10001 /backup

docker run \
    --rm \
    --network none \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --user 10001:10001 \
    --mount "type=volume,src=$DATA_VOLUME,dst=/source,readonly" \
    --mount "type=bind,src=$INCOMPLETE_DIRECTORY,dst=/backup" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/tool.py,readonly" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_backup_models.py,dst=/atlas_data_backup_models.py,readonly" \
    --mount "type=bind,src=$ATLAS_ROOT/config,dst=/opt/atlas/config,readonly" \
    --mount "type=bind,src=$ATLAS_ROOT/inventory,dst=/opt/atlas/inventory,readonly" \
    "$backup_image" \
    python /tool.py backup \
    /source \
    /backup \
    --operator-auth-initialized "$operator_auth_initialized" \
    "${provider_intent_options[@]}"

validate_incomplete_directory
docker run \
    --rm \
    --network none \
    --read-only \
    --cap-drop ALL \
    --cap-add CHOWN \
    --cap-add DAC_READ_SEARCH \
    --security-opt no-new-privileges:true \
    --user 0:0 \
    --mount "type=bind,src=$BACKUP_ROOT,dst=/backup-parent" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas-data-tool.py,dst=/tool.py,readonly" \
    --mount "type=bind,src=$SCRIPT_DIRECTORY/atlas_data_backup_models.py,dst=/atlas_data_backup_models.py,readonly" \
    "$PYTHON_IMAGE" \
    python /tool.py chown-child \
    /backup-parent \
    "$INCOMPLETE_BASENAME" \
    "$BACKUP_OWNER_UID" \
    "$BACKUP_OWNER_GID"
chmod 0700 "$INCOMPLETE_DIRECTORY"

mv -- "$INCOMPLETE_DIRECTORY" "$BACKUP_DIRECTORY"
trap - EXIT

echo "Atlas data backup created: $BACKUP_DIRECTORY"
