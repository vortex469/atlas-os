ATLAS_HTTP_BIND=127.0.0.1
ATLAS_HTTP_PORT=8080

# Required for production Codex execution. Keep this file outside Git and the image.
# The file must contain the Codex auth state and be readable by the container runtime.
# ATLAS_CODEX_AUTH_HOST_PATH=/root/.codex/auth.json

# Required only with compose.https.yaml:
# ATLAS_HTTPS_BIND=0.0.0.0
# ATLAS_HTTPS_PORT=443
# ATLAS_EDGE_UID=101
# ATLAS_TLS_CERT_FILE=./secrets/atlas.crt
# ATLAS_TLS_KEY_FILE=./secrets/atlas.key
# ATLAS_HTPASSWD_FILE=./secrets/atlas.htpasswd

# Required together with compose.provider-intent-activated.yaml. Omit both for
# the default not_activated deployment.
# ATLAS_PROVIDER_INTENT_DATABASE=/opt/atlas/data/provider_intents.db
# ATLAS_PROVIDER_INTENT_EXPECTED_LEGACY_IMPORT_ID=provider-intent-legacy-policy-import-v1:<sha256>

# Optional. When set to true, Core performs one bounded startup refresh of the
# fixed Frigate GitHub latest-release source into the rebuildable Discovery cache.
# Defaults to false (no dynamic refresh or egress). Previously cached dynamic
# evidence may remain readable until its 30-day expiry.
# ATLAS_ENABLE_DISCOVERY_DYNAMIC_REFRESH=false

PROXMOX_USER=atlas@pve
PROXMOX_TOKEN_NAME=atlas-core
PROXMOX_TOKEN_VALUE=replace-me

HASS_TOKEN=replace-me

OPNSENSE_API_KEY=replace-me
OPNSENSE_API_SECRET=replace-me

FRIGATE_API_TOKEN=replace-me

QDRANT_API_KEY=replace-me

N8N_API_KEY=replace-me
