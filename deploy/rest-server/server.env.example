# Bind to a private/VPN address on the physically separate backup host.
REST_SERVER_BIND=127.0.0.1
REST_SERVER_PORT=8000

# These paths are resolved on the Rest Server host.
REST_SERVER_DATA_PATH=/srv/atlas-restic
REST_SERVER_HTPASSWD_FILE=/etc/atlas-rest-server/htpasswd
REST_SERVER_TLS_CERT_FILE=/etc/atlas-rest-server/server.crt
REST_SERVER_TLS_KEY_FILE=/etc/atlas-rest-server/server.key

# The host paths above must be accessible to this numeric identity.
REST_SERVER_UID=10001
REST_SERVER_GID=10001
