# Use a mounted path on separate or remote storage for disaster recovery.
ATLAS_BACKUP_ROOT=/opt/atlas/backups
ATLAS_BACKUP_RETENTION_DAYS=30
ATLAS_BACKUP_MINIMUM_COUNT=7

# Remote Restic replication is enabled by creating /etc/atlas/restic.env.
# For an internal CA, place its public certificate here:
ATLAS_RESTIC_CA_FILE=/etc/atlas/restic-ca.pem
