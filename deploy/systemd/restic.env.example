# Keep this file mode 0600. The repository path must begin with the
# authenticated username when Rest Server uses --private-repos.
RESTIC_REPOSITORY=rest:https://backup.example.internal:8000/atlas
RESTIC_REST_USERNAME=atlas
RESTIC_REST_PASSWORD=replace-with-a-long-random-transport-password

# This separate password encrypts repository contents. Losing it makes the
# backup unrecoverable.
RESTIC_PASSWORD=replace-with-a-long-random-repository-password
